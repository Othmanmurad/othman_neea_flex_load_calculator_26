.venv/
.vscode/
__pycache__/
*.pyc

# HPWH bulk data -- regenerable via HPWH_A1/A2/A3 (per-home ResStock
# datasets) or simulation output (Ready_data/), not primary source data.
# HPWH/Weather/ is intentionally NOT excluded -- it's a single small EPW
# file, worth tracking like code.
HPWH/*Input Files*/
HPWH/Ready_data/
HPWH/Metadata/
HPWH/HPWH Filtered/

# Local last-run state (see HPWH/run_context.py) -- which test the C scripts open,
# not something to share across machines.
HPWH/.last_*

# PES paper (IEEE) work: results are simulation output, and the input folder is
# a junction to HPWH's input files.
pes_paper/Ready_data/
pes_paper/*Input Files*/
pes_paper/*Input Files*
pes_paper/.last_*

# Other FLC loads (ERWH, AC, HEAT, EV, Battery, Dryer): results are simulation output, and the
# input folders are junctions to HPWH's input files.
/ERWH/Ready_data/
/AC/Ready_data/
/HEAT/Ready_data/
/EV/Ready_data/
/Battery/Ready_data/
/Dryer/Ready_data/
/ERWH/*Input Files*
/AC/*Input Files*
/HEAT/*Input Files*
/EV/*Input Files*
/Battery/*Input Files*
/Dryer/*Input Files*
/ERWH/.last_*
/AC/.last_*
/HEAT/.last_*
/EV/.last_*
/Battery/.last_*
/Dryer/.last_*

# FLC Combo (all loads together): results are simulation output.
/Combo/Ready_data/
/Combo/.last_*

~$FL Reserve Calculator.xlsm
/ERWH/ERWH Filtered/
